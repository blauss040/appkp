# ============================================================================
# K&P SAÚDE ANIMAL — CONFIGURAÇÕES DE AMBIENTE
# Copie este arquivo para .env e preencha com suas credenciais locais
# Exemplo: cp .env.exemplo .env
# ============================================================================

# Porta do Servidor HTTP Node.js
PORT=9000

# Conexão com o Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kpsaude_db
DB_USER=postgres
DB_PASSWORD=sua_senha_do_postgres_aqui

# Segredo para assinatura de Tokens JWT (Utilize uma chave forte e aleatória em produção)
JWT_SECRET=kp_saude_animal_jwt_secret_token_chave_privada_2026
JWT_EXPIRES_IN=7d

# Ambiente de Execução (development | production)
NODE_ENV=development
